{
  "$comment": "model_slot 三枚举（唯一合法值）+ section schema 中的唯一合法声明写法。A1 的 section schema 里只允许出现这三个值 + 展示开关；出现资产路径 / 模型 ID / .glb 即门禁[5] FAIL。",
  "version": "1.1.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "enum": ["hero_master", "active_child", "dormant_poster"],
  "definitions": {
    "hero_master":   { "meaning": "独立页 Hero 母模型；全站每业务线唯一；完整权限（含 recolor / reskin_season）", "glb": true,  "hot_canvas": true,  "line_route": { "bundle": "/pages/bundles", "mto": "/pages/made-to-order", "scene": "/pages/scene" } },
    "active_child":  { "meaning": "活跃子模型，3D 直接业务；零换色权，100% 派生母",                        "glb": true,  "hot_canvas": true,  "perm_lock": { "recolor": false, "reskin_season": false } },
    "dormant_poster":{ "meaning": "沉睡子模型，近 2D poster + 虚线 silhouette；S0 阶段 0 个 GLB 请求",      "glb": false, "hot_canvas": false, "poster_max_kb": 90, "perm_lock": { "recolor": false, "reskin_season": false, "configure": false } }
  },
  "section_declaration_example": {
    "$comment": "示例，非规范路径。这是 section 内联 {{#schema}} 里唯一合法的模型相关写法。",
    "settings": [
      { "id": "model_slot", "type": "select", "default": "hero_master",
        "options_0": "hero_master", "options_1": "active_child", "options_2": "dormant_poster" },
      { "id": "enable_3d_viewer", "type": "checkbox", "default": true },
      { "id": "promote_on_hover", "type": "checkbox", "default": false }
    ],
    "forbidden_in_schema": ["model_url", "glb", "master_id", "sku", "https", "金额", "百分比", "裸 hex"]
  },
  "resolution_contract": {
    "call": "SpaceVanta.api.get('bundle', '/model/resolve', { slot, line, id, locale })",
    "returns": ["url|null", "poster", "silhouette", "version", "perm(7位)", "master_page_url", "budget", "ttl"],
    "invariant_dormant_url_is_null": true,
    "cta_to_master_mandatory_for": ["active_child", "dormant_poster(after promote to S3)"]
  }
}
